{
  "name": "lagesplan-3d-editor",
  "productName": "3D-editor Lägesplan",
  "version": "1.0.0",
  "description": "Fristående 3D-editor för arbetsplatsplanering – fungerar utan Trimble Connect",
  "main": "main.js",
  "author": "Victor Falk",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "se.ncc.lagesplan3d",
    "productName": "3D-editor Lägesplan",
    "files": ["main.js", "server.js", "package.json", "app/**/*"],
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "artifactName": "3D-editor-Lagesplan-${version}-${target}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "createDesktopShortcut": true }
  }
}
